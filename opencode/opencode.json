{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 3,
  "mcp": {
    "mcp_context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  },
  "default_agent": "main",
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  },
  "permission": {
    "mcp_*": "deny",
    "task": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "skill": "allow",
    "question": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git push": "ask",
      "git push *": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/repos/**": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny"
  }
}
